{
  "name": "schooldashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "audit:ci": "audit-ci --config audit-ci.jsonc",
    "test:audit-policy": "node scripts/verify-audit-policy.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run && npm run test:icm-automation",
    "test:icm-automation": "node --test tests/icm-automation/automation.test.mjs tests/icm-automation/review.test.mjs tests/icm-automation/trusted-foundation.test.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:security": "node scripts/run-security-e2e.mjs",
    "test:client-bundle-secrets": "node scripts/check-client-bundle-secrets.mjs",
    "supabase:ci:start": "node scripts/start-local-supabase-ci.mjs",
    "supabase:db:reset": "supabase db reset --local",
    "supabase:test:db": "supabase test db --local"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "audit-ci": "7.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.5.28",
    "supabase": "2.120.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
